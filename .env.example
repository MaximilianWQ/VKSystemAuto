# Реальные значения живут в Railway Variables, не здесь.

# --- обязательные ---
VK_GROUP_ID=
VK_CONFIRMATION_CODE=
VK_SECRET_KEY=
SESSION_SECRET=

# Токен сообщества. Принимается и под старым именем VK_TOKEN.
VK_GROUP_TOKEN=
ADMIN_ID=

# Подставляется сервисом Postgres в Railway.
DATABASE_URL=

# --- необязательные, показаны значения по умолчанию ---
# Если пусто, выводится из RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
VK_API_VERSION=5.199
VK_MODE=callback
WORK_HOURS=10-19
TZ=Europe/Moscow

# --- второй этап, дашборд ---
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
